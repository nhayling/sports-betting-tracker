# Copy to .env next to docker-compose.yml on the server.

# The hostname people will open, pointing at this server (DNS A record).
# No domain? Use <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
DOMAIN=bets.example.com

# Database password. Letters and numbers only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
