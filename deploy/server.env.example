# Copy to .env next to docker-compose.yml on the server.

# The hostname people will open, pointing at this server (DNS A record).
# No domain? Use <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
DOMAIN=slipclub.app

# Moving to a new DOMAIN? List the old one(s) here, space-separated, so installed
# extensions and phone sync keep working until everyone has moved (docs/deploy.md).
OLD_DOMAINS=

# How DOMAIN gets its HTTPS certificate:
#   auto        Let's Encrypt; DNS points straight at this server (Cloudflare: grey cloud).
#   cloudflare  Behind Cloudflare's proxy (orange cloud): save a Cloudflare Origin
#               Certificate as cert.pem and private.key in CERTS_DIR, and set
#               Cloudflare's SSL/TLS mode to Full (strict).
DOMAIN_TLS=auto
# Folder holding the origin certificate, relative to this file. Default: a certs
# folder next to the project folder, which deploys never touch.
#CERTS_DIR=../certs

# Database password. Letters and numbers only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Emails about requests to join, sent through Postmark (the server's API token).
# Upload the templates first: npm run emails -w @sports-better/api -- push
# EMAIL_FROM must be on a domain or address verified in Postmark.
POSTMARK_API_TOKEN=
#EMAIL_FROM=Slip Club <hello@slipclub.app>
#EMAIL_REPLY_TO=slipclub@archipelagoapps.com
